        </dependency>
        <dependency>
            <groupId>obp-client-kernel</groupId>
            <artifactId>obp-client-kernel</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${pom.basedir}/lib/obp-client-kernel-1.0.0-SNAPSHOT.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>obp-easysdk</groupId>
            <artifactId>obp-easysdk</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${pom.basedir}/lib/obp-easysdk-1.0.0-SNAPSHOT.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>obp-easysdk-spring-boot-starte</groupId>
            <artifactId>obp-easysdk-spring-boot-starte</artifactId>
            <version>1.0</version>
